# Supabase — use Publishable key (sb_publishable_...), NOT legacy anon key.
# Both URL and publishable key are required.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: server-only admin tooling (NOT needed for this template)
# SUPABASE_SECRET_KEY=sb_secret_your_key_here
